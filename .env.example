# Betriebsmodus: "public" (gehostete Anmeldung) oder "local" (Turniertag, Verwaltung)
APP_MODE=local

# Pfad zur SQLite-Datei (auf Fly.io z. B. /data/cornhole.db auf dem Volume)
DATABASE_PATH=./data/cornhole.db

# Gemeinsamer geheimer Schlüssel für die Synchronisation lokal <-> gehostet
SYNC_TOKEN=
# Nur lokal: URL der gehosteten Anmelde-Instanz. Leer = Standalone-Betrieb ohne Sync.
HOSTED_URL=

# Turnier / Zahlung
TOURNAMENT_NAME=Cornhole-Turnier 2026
TOURNAMENT_IBAN=AT00 0000 0000 0000 0000
TOURNAMENT_ACCOUNT_HOLDER=Cornhole-Verein
ENTRY_FEE=30,00 €
PAYMENT_REF_PREFIX=CH2026
PAYMENT_DAYS=14
MAX_TEAMS=64

# Mailversand (leer = Mails werden nur in der Konsole ausgegeben)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Cornhole-Turnier <turnier@example.org>
